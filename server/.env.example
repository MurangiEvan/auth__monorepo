# Database connection string from Neon (e.g. postgresql://user:password@ep-xyz.region.neon.tech/neondb?sslmode=require)
DATABASE_URL=postgresql://user:password@ep-xyz.region.neon.tech/neondb?sslmode=require

# JWT signing secret (use a strong random secret in production)
JWT_SECRET=your_jwt_secret_key_here

# Frontend origin(s) allowed by CORS (comma-separated if multiple)
CLIENT_URL=https://client-two-omega-44.vercel.app,http://localhost:3000

# Express server port
PORT=5000
